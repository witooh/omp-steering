{
  "name": "@witooh/omp-steering",
  "version": "0.1.0",
  "description": "Load Kiro steering files into omp",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witooh/omp-steering.git"
  },
  "keywords": [
    "omp-package",
    "omp",
    "omp-extension",
    "kiro",
    "steering"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@oh-my-pi/pi-coding-agent": "17.2.2",
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
